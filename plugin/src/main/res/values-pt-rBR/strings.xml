    <!-- SETTINGS PAGE                                                   -->
    <!-- ============================================================== -->
    <string name="settings_git_global">Integração com Git</string>
    <string name="settings_git_global_desc">Detecta repositórios e ativa todos os recursos do Git. Desative para forçar o modo pasta mesmo dentro de um repositório. As regras do .gitignore continuam sendo aplicadas.</string>
    <string name="settings_animations">Animações</string>
    <string name="settings_animations_desc">Transições de fade e escala no diálogo, árvore e seletor de perfis. Desative em dispositivos de baixo desempenho.</string>
    <string name="settings_notifications">Notificações de geração</string>
    <string name="settings_notifications_desc">Notificações de progresso, conclusão e erro durante a exportação. Desative para silenciar a bandeja.</string>
    <string name="settings_force_english">Forçar interface em inglês</string>
    <string name="settings_force_english_desc">Força a interface do plugin a usar inglês, independentemente do idioma do IDE. Diálogos e telas recém-abertos usam inglês; janelas já abertas mantêm seu idioma atual até serem reabertas.</string>
    <string name="settings_total_export_limit">Limite total de exportação (KB)</string>
    <string name="settings_total_export_limit_desc">Limite máximo, em kilobytes, do tamanho total de um único dump. Ao ser atingido, a exportação deixa de incluir arquivos e acrescenta um aviso de truncamento. Útil principalmente quando o limite por arquivo está desativado. Defina 0 para não ter limite.</string>

