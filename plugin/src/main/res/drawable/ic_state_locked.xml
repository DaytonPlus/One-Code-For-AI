<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- Locked state: a padlock. Used by the tri-state indicator of the
         project tree for nodes that are hard-excluded (like .git or
         node_modules) or binary, and that have not been unlocked via the
         "Show locked" toggle. Distinct from the exclude glyph so the user
         can tell "not included" apart from "not interactable yet". -->
    <path android:strokeColor="#D99460" android:strokeWidth="1.8"
        android:fillColor="#00000000" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M7,10 L17,10 L17,20 L7,20 Z M9,10 L9,7 A3,3 0 0,1 15,7 L15,10" />
    <!-- Keyhole: a short line above a small dot. -->
    <path android:strokeColor="#D99460" android:strokeWidth="1.8"
        android:fillColor="#00000000" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M12,13 L12,16" />
</vector>